# Pflicht: unter welcher Domain laeuft diese Instanz?
RLS_DOMAIN=netzwerk.example.org

# Pflicht: wie heisst sie?
RLS_APP_NAME=Unser Netzwerk

# Relay. Solange es ein gemeinsames gibt, bleibt das hier stehen.
RLS_RELAY_URL=wss://relay.web-of-trust.de

# Voreingestellter Connector (wot | supabase | local | mock).
# Ein unbekannter Wert wird verworfen — die App faellt dann auf wot zurueck.
RLS_DEFAULT_CONNECTOR=wot

# Nur wenn die Instanz auf Supabase statt WoT laeuft:
# RLS_SUPABASE_URL=https://supabase.example.org
# RLS_SUPABASE_ANON_KEY=

# Image-Tag. "1" folgt Korrekturen innerhalb der Major-Version.
# RLS_IMAGE_TAG=1

# Nur fuer die lokale Vorschau, falls 8080 belegt ist
# RLS_PORT=8081

# Nur wenn euer Traefik-Netz anders heisst
# TRAEFIK_NETWORK=web
