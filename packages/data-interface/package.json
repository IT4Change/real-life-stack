{
  "name": "@real-life-stack/data-interface",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./demo-data": {
      "types": "./dist/src/demo-data.d.ts",
      "development": "./src/demo-data.ts",
      "import": "./dist/src/demo-data.js"
    },
    "./testing": {
      "types": "./dist/src/testing/contract-suite.d.ts",
      "development": "./src/testing/contract-suite.ts",
      "import": "./dist/src/testing/contract-suite.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.0"
  }
}
