{
  "name": "@real-life-stack/wot-connector",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "development": "./src/components/index.ts",
      "import": "./dist/components/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@real-life-stack/data-interface": "workspace:*",
    "@real-life-stack/toolkit": "workspace:*",
    "@real-life/adapter-yjs": "https://github.com/real-life-org/web-of-trust/releases/download/adapter-yjs-v0.1.8/web_of_trust-adapter-yjs-0.1.8.tgz",
    "@real-life/wot-core": "https://github.com/real-life-org/web-of-trust/releases/download/core-v0.4.1/web_of_trust-core-0.4.1.tgz"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@capacitor/core": "^8.2.0",
    "@types/react": "^19.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fake-indexeddb": "^6.2.5",
    "lucide-react": "^0.468.0",
    "typescript": "~5.7.2",
    "vitest": "^4.1.0",
    "yjs": "^13.6.30"
  }
}
