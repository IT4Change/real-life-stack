{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://real-life-stack.org/vocab/person/v1/schema.json",
  "title": "RLS Person Vocabulary",
  "description": "Profile fields for items representing a person. Used by Contacts / Profile views.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "data": {
      "type": "object",
      "additionalProperties": true,
      "required": ["displayName"],
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        },
        "avatarUrl": {
          "type": "string",
          "format": "uri"
        },
        "bio": {
          "type": "string"
        },
        "pronouns": {
          "type": "string"
        }
      }
    }
  },
  "required": ["data"]
}
