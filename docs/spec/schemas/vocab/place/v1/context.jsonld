{
  "@context": {
    "@version": 1.1,
    "rls": "https://real-life-stack.org/vocab/place/v1#",
    "geo": "https://purl.org/geojson/vocab#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "position": { "@id": "geo:geometry" },
    "address": { "@id": "rls:address", "@type": "xsd:string" },
    "locationName": { "@id": "rls:locationName", "@type": "xsd:string" }
  }
}
